# dama local development
NODE_ENV=development

# Postgres (local placeholders only - never commit real credentials)
# Host port is 5434 (see docker-compose). Use this for pgAdmin / psql from the host.
DAMA_POSTGRES_USER=dama
DAMA_POSTGRES_PASSWORD=change-me-local-db
DAMA_POSTGRES_DB=dama
POSTGRES_USER=dama
POSTGRES_PASSWORD=change-me-local-db
POSTGRES_DB=dama
DATABASE_URL=postgres://dama:change-me-local-db@localhost:5434/dama?sslmode=disable
DAMA_DATABASE_URL=postgres://dama:change-me-local-db@localhost:5434/dama?sslmode=disable
# Optional pgAdmin UI: docker compose up -d pgadmin  ->  http://localhost:5050
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me-pgadmin
PGADMIN_PORT=5050
# Production MUST set DATABASE_URL. DAMA_ALLOW_MEMORY=1 is local smoke only.
# DAMA_ALLOW_MEMORY=1

# Redis (password required; matches docker-compose requirepass)
REDIS_PASSWORD=change-me-local-redis
# Host port 7379 maps to container 6379 when the default host port is unavailable.
REDIS_URL=redis://:change-me-local-redis@localhost:7379/0
DAMA_REDIS_URL=redis://:change-me-local-redis@localhost:7379/0
# Optional pooler host port (maps to 5432 in container): localhost:7432

# API
PORT=8080
DAMA_API_HOST=0.0.0.0
DAMA_API_PORT=8080
# Required for API and docker-compose (compose has no weak JWT default).
JWT_SECRET=change-me-in-production-use-long-random-string
DAMA_JWT_SECRET=change-me-in-production-use-long-random-string
# Required for vault encryption (compose requires this explicitly).
DAMA_SECRETS_KEY=change-me-aes256-secrets-key-32b
# Local smoke without secrets only:
# DAMA_ALLOW_DEV_SECRETS=1
# Local CORS allow-list (server-side only). Never put console origins in client NEXT_PUBLIC_*.
# Add the console origin only on machines that run the console (do not publish console ports in client apps).
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:3201,http://127.0.0.1:3201
DAMA_CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:3201,http://127.0.0.1:3201
# Example when running console locally: append ,http://localhost:${DAMA_CONSOLE_PORT}
# Note: Windows Hyper-V often excludes TCP 2918-3017 so admin may bind :3201 instead of :3001.
# VS-AI defaults come from Postgres feature_flags only (fail closed when missing).
# Opt-in GraphQL HTML playground (off by default).
# DAMA_GRAPHQL_PLAYGROUND=1
# Opt-in local payment completion helper (off by default; never enable in production).
# When set, registers GET /api/v1/payments/dev/payment-complete only.
# DAMA_ALLOW_PAYMENT_STUB=1

# Optional first-boot console seed (never commit real values). If unset, no console user is auto-created.
# Social-only bootstrap (no password). Optional: link a console user for first Google sign-in.
# DAMA_SEED_ADMIN_EMAIL=
# DAMA_SEED_ADMIN_USERNAME=admin
# DAMA_SEED_ADMIN_SUPABASE_ID=
# DAMA_SEED_ADMIN_ROLE=
# Local E2E smoke only (never in production): POST /api/v1/auth/e2e/session
# DAMA_ALLOW_E2E_AUTH=1

# Public web app only. Do not add console URLs to NEXT_PUBLIC_*.
NEXT_PUBLIC_API_URL=http://localhost:8080/graphql
NEXT_PUBLIC_REST_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws
NEXT_PUBLIC_BRAND_NAME=dama
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Auth + optional hosted Postgres). Project Settings → API / Database.
SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_JWT_SECRET=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Hosted Postgres (set password; do not put these in NEXT_PUBLIC_*):
# SUPABASE_DB_PASSWORD=
# SUPABASE_DB_DIRECT_URL=postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres
# SUPABASE_DB_POOLER_TRANSACTION_URL=postgresql://postgres.PROJECT:PASSWORD@aws-….pooler.supabase.com:6543/postgres
# Web/admin clients (apps/*/ .env.local): NEXT_PUBLIC_SUPABASE_URL + ANON (+ optional PUBLISHABLE).
# Never put SERVICE_ROLE / SECRET_KEY / DB password in NEXT_PUBLIC_*.
# Auth providers allow-list is database-only (GET /public/auth-providers).

# =============================================================================
# Payments - Chapa (Ethiopia) - https://developer.chapa.co
# Dashboard: Settings → API | Settings → Webhooks
# Auth: Bearer CHAPA_SECRET_KEY → POST {CHAPA_BASE_URL}/transaction/initialize
# Webhook: chapa-signature / x-chapa-signature (secret hash or secret key)
# =============================================================================
CHAPA_SECRET_KEY=
CHAPA_PUBLIC_KEY=
CHAPA_ENCRYPTION_KEY=
CHAPA_WEBHOOK_SECRET=
CHAPA_WEBHOOK_URL=http://localhost:8080/api/v1/payments/local/webhook
CHAPA_BASE_URL=https://api.chapa.co/v1
CHAPA_TEST_MODE=true

# =============================================================================
# Payments - Paddle Billing - https://developer.paddle.com
# Dashboard: Authentication (API key + client-side token) | Notifications
# Auth: Bearer PADDLE_API_KEY → POST {api|sandbox-api}.paddle.com/transactions
# Webhook: Paddle-Signature verified with PADDLE_WEBHOOK_SECRET (endpoint secret)
# PADDLE_ENV must match key: live (pdl_live_…) or sandbox (pdl_sdbx_…)
# =============================================================================
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_CLIENT_TOKEN=
PADDLE_ENV=live
# PADDLE_API_BASE=
PADDLE_WEBHOOK_URL=http://localhost:8080/api/v1/payments/international/webhook
# NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
# NEXT_PUBLIC_PADDLE_ENV=live

DAMA_PUBLIC_API_BASE=http://localhost:8080
DAMA_RATE_LIMIT_PER_MINUTE=120
# Docker / load-balancer readiness probe budget (GET /readyz and `server -readyz`).
DAMA_READYZ_TIMEOUT_SEC=5
# Production template: see .env.production.example and docs/ops-deploy.md.

# =============================================================================
# Shared Telegram ops bot (manual receipt + payout) - server/worker only
# Runtime SoT is platform_settings.telegram_ops_bot (admin /payments/telegram-ops):
#   enabled, bot_service_url, bot_api_key, reviewer_user_id, notify_timeout_ms.
# Reviewer UUID is DB/console only - there is no DAMA_TELEGRAM_OPS_REVIEWER_USER_ID env.
# API→bot notify target is DB bot_service_url (not BOT_SERVICE_URL below).
#   Docker API process: http://host.docker.internal:<bot-port> (not API loopback :8080).
# On the bot worker both DAMA_API_BASE_URL + DAMA_BOT_API_KEY are required (fail closed).
# DAMA_BOT_API_KEY must match DB bot_api_key and is required as X-Bot-Key on:
#   - bot → Dama /telegram-bot/admin/dama/*
#   - Dama → bot POST /api/v1/notify (inbound Dama payloads)
# Never put these in NEXT_PUBLIC_*.
# TELEGRAM_ADMIN_IDS required for Dama money DMs (empty set fails closed - mig 424).
# On Render/shared host, DAMA_API_BASE_URL must be a public API URL (not 127.0.0.1).
# =============================================================================
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=
# TELEGRAM_ADMIN_IDS=
# BOT_SERVICE_URL=https://your-telegram-bot-worker
# RENDER_SERVICE_URL=https://your-telegram-bot-worker
# BACKEND_API_URL=https://legacy-python-api/api/v1
# DAMA_BOT_API_KEY=
# DAMA_API_BASE_URL=https://your-dama-api/api/v1
# DAMA_HTTP_TIMEOUT_SECONDS=15

# Media CDN. Production must set credentials.
# Local smoke without CDN: DAMA_ALLOW_LOCAL_MEDIA=true
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Client-facing media origin required for CDN delivery URLs (Cloudinary cloud or custom CNAME).
# Example Cloudinary: https://res.cloudinary.com/<cloud_name>
# Example CNAME: https://media.yourdomain.com
# DAMA_MEDIA_PUBLIC_BASE=
# Web Next.js image allow-list (hostname only, no scheme):
# NEXT_PUBLIC_MEDIA_CDN_HOST=res.cloudinary.com
DAMA_UPLOAD_DIR=./uploads
DAMA_ALLOW_LOCAL_MEDIA=false
# Video stub uploads only for local smoke without OAuth refresh tokens
DAMA_ALLOW_YT_STUB=false
