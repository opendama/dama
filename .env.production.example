# Production / staging env template for Dama.
# Copy to .env.prod (or your host secrets store). Never commit filled values.
#
# Typical cloud stack (same shape as Trim):
#   Web   → Vercel / Cloudflare Pages   (apps/web)
#   Admin → Vercel (second project)     (apps/admin)
#   API   → Render / Fly / Docker       (apps/api)
#   DB    → Supabase Postgres
#   Redis → Upstash (rediss://…)
#   Auth  → Supabase Auth (Google)

NODE_ENV=production

# --- API identity / signing (required; long random) ---
DAMA_JWT_SECRET=
DAMA_SECRETS_KEY=
DAMA_READYZ_TIMEOUT_SEC=5
# After first successful migrate on a host, set 1 so boot does not re-apply every *.sql:
# DAMA_SKIP_MIGRATE=1

# --- Postgres (Supabase pooler preferred for API) ---
# Direct: postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres
# Pooler: postgresql://postgres.PROJECT:PASSWORD@aws-….pooler.supabase.com:6543/postgres
DATABASE_URL=
DAMA_DATABASE_URL=

# --- Redis (Upstash: rediss://default:TOKEN@HOST:6379) ---
REDIS_URL=
DAMA_REDIS_URL=

# --- Public API origin (no trailing path) ---
DAMA_PUBLIC_API_BASE=https://api.opendama.com
DAMA_API_PUBLISH_PORT=8080

# --- CORS: web + admin production origins only (comma-separated) ---
DAMA_CORS_ORIGINS=https://opendama.com,https://www.opendama.com,https://admin.opendama.com

# --- Supabase Auth (API) ---
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_JWT_SECRET=
SUPABASE_ANON_KEY=
# Server-only if needed for ops; never put in NEXT_PUBLIC_*:
# SUPABASE_SERVICE_ROLE_KEY=

# --- Media CDN ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
DAMA_MEDIA_PUBLIC_BASE=https://res.cloudinary.com/YOUR_CLOUD
DAMA_ALLOW_LOCAL_MEDIA=false

# --- Payments (fill only what you enable in platform_settings) ---
CHAPA_SECRET_KEY=
CHAPA_PUBLIC_KEY=
CHAPA_ENCRYPTION_KEY=
CHAPA_WEBHOOK_SECRET=
CHAPA_BASE_URL=https://api.chapa.co/v1
CHAPA_TEST_MODE=false
CHAPA_WEBHOOK_URL=https://api.opendama.com/api/v1/payments/local/webhook

PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_CLIENT_TOKEN=
PADDLE_ENV=live
PADDLE_WEBHOOK_URL=https://api.opendama.com/api/v1/payments/international/webhook

# --- Telegram ops bot (optional; runtime SoT also in platform_settings) ---
# DAMA_BOT_API_KEY=
# DAMA_API_BASE_URL=https://api.opendama.com/api/v1

# --- Never enable in production ---
# DAMA_ALLOW_MEMORY=1
# DAMA_ALLOW_DEV_SECRETS=1
# DAMA_ALLOW_E2E_AUTH=1
# DAMA_ALLOW_PAYMENT_STUB=1

# =============================================================================
# Web (Vercel project: apps/web) - browser-safe only
# =============================================================================
# NEXT_PUBLIC_API_URL=https://api.opendama.com/graphql
# NEXT_PUBLIC_REST_URL=https://api.opendama.com/api/v1
# NEXT_PUBLIC_WS_URL=wss://api.opendama.com/ws
# NEXT_PUBLIC_SITE_URL=https://opendama.com
# NEXT_PUBLIC_BRAND_NAME=dama
# NEXT_PUBLIC_SUPABASE_URL=https://PROJECT.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_MEDIA_CDN_HOST=res.cloudinary.com

# =============================================================================
# Admin (Vercel project: apps/admin) - separate deploy; never share console ports in web
# =============================================================================
# NEXT_PUBLIC_API_URL=https://api.opendama.com/graphql
# NEXT_PUBLIC_REST_URL=https://api.opendama.com/api/v1
# NEXT_PUBLIC_WS_URL=wss://api.opendama.com/ws
# NEXT_PUBLIC_SUPABASE_URL=https://PROJECT.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
