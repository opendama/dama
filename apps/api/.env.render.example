# Render import template for dama-api - copy to apps/api/.env.render (gitignored).
# Do not commit filled values. Render injects PORT; leave DAMA_API_PORT unset or match.
#
# Service settings (dashboard):
#   Runtime: Docker
#   Dockerfile path: Dockerfile
#   Docker build context: apps/api
#   Health check path: /readyz
#   Region: same as Supabase when possible

DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-….pooler.supabase.com:6543/postgres?sslmode=require
DAMA_DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-….pooler.supabase.com:6543/postgres?sslmode=require
REDIS_URL=rediss://default:TOKEN@HOST.upstash.io:6379
DAMA_REDIS_URL=rediss://default:TOKEN@HOST.upstash.io:6379

DAMA_JWT_SECRET=
DAMA_SECRETS_KEY=
DAMA_READYZ_TIMEOUT_SEC=5
DAMA_RATE_LIMIT_PER_MINUTE=120
# After first green migrate on this DB:
# DAMA_SKIP_MIGRATE=1

DAMA_PUBLIC_API_BASE=https://api.yourdomain.com
DAMA_CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com,https://admin.yourdomain.com

SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_JWT_SECRET=
SUPABASE_ANON_KEY=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
DAMA_MEDIA_PUBLIC_BASE=https://res.cloudinary.com/CLOUD
DAMA_ALLOW_LOCAL_MEDIA=false

CHAPA_SECRET_KEY=
CHAPA_PUBLIC_KEY=
CHAPA_WEBHOOK_SECRET=
CHAPA_BASE_URL=https://api.chapa.co/v1
CHAPA_TEST_MODE=false
CHAPA_WEBHOOK_URL=https://api.yourdomain.com/api/v1/payments/local/webhook

PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_CLIENT_TOKEN=
PADDLE_ENV=live
PADDLE_WEBHOOK_URL=https://api.yourdomain.com/api/v1/payments/international/webhook

# Never set on Render:
# DAMA_ALLOW_MEMORY=1
# DAMA_ALLOW_DEV_SECRETS=1
# DAMA_ALLOW_E2E_AUTH=1
# DAMA_ALLOW_PAYMENT_STUB=1
