NEXT_PUBLIC_API_URL=http://localhost:8080/graphql
NEXT_PUBLIC_REST_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws
NEXT_PUBLIC_BRAND_NAME=dama
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Supabase Auth (Google). Browser-safe only - never service_role / secret / DB password.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Edge middleware paths (must match platform_settings.auth_providers.site.*).
NEXT_PUBLIC_APP_PATH_LOGIN=/auth/login
NEXT_PUBLIC_APP_PATH_AUTH_CALLBACK=/auth/callback
NEXT_PUBLIC_APP_PATH_OAUTH_COMPLETE=/auth/oauth/complete
# Message when Supabase env is missing (align with auth_providers.login_missing_supabase_env).
NEXT_PUBLIC_SUPABASE_ENV_MISSING=Supabase Auth is not configured.
# Optional: CDN hostname allowed by next/image (no vendor hardcode in next.config).
# NEXT_PUBLIC_MEDIA_CDN_HOST=res.example.com
