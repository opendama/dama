{
  "extends": "@dama/typescript-config/nextjs.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "@dama/ui": ["../../packages/ui/src/index.ts"],
      "@dama/ui/*": ["../../packages/ui/src/*"]
    },
    "plugins": [{ "name": "next" }]
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", "src/gql", "**/*.test.ts", "**/*.test.tsx"]
}
