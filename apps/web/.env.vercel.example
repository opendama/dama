# Vercel import for @dama/web - copy to apps/web/.env.vercel (gitignored).
# Dashboard: Root Directory = apps/web; include files outside root for pnpm workspace.

NEXT_PUBLIC_API_URL=https://api.opendama.com/graphql
NEXT_PUBLIC_REST_URL=https://api.opendama.com/api/v1
NEXT_PUBLIC_WS_URL=wss://api.opendama.com/ws
NEXT_PUBLIC_BRAND_NAME=dama
NEXT_PUBLIC_SITE_URL=https://www.opendama.com

NEXT_PUBLIC_SUPABASE_URL=https://PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

NEXT_PUBLIC_APP_PATH_LOGIN=/auth/login
NEXT_PUBLIC_APP_PATH_AUTH_CALLBACK=/auth/callback
NEXT_PUBLIC_APP_PATH_OAUTH_COMPLETE=/auth/oauth/complete
NEXT_PUBLIC_SUPABASE_ENV_MISSING=Supabase Auth is not configured.

NEXT_PUBLIC_MEDIA_CDN_HOST=res.cloudinary.com
# NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
# NEXT_PUBLIC_PADDLE_ENV=live
