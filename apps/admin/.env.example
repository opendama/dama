# Console app only. Never copy these into the player web app NEXT_PUBLIC_* set.
# Bind port is local/ops only (compose uses DAMA_CONSOLE_PORT).
# Prefer 3001 when free. On Windows Hyper-V hosts, 2918-3117 is often excluded - use 3201.
PORT=3201
# Match root .env DAMA_API_PUBLISH_PORT (often 18080 on Windows when 8080 is reserved).
NEXT_PUBLIC_API_URL=http://localhost:18080/graphql
NEXT_PUBLIC_REST_URL=http://localhost:18080/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:18080/ws
# Browser-safe only - never service_role / secret / DB password.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Edge middleware paths (must match platform_settings.auth_providers.site.*).
NEXT_PUBLIC_APP_PATH_LOGIN=/auth/login
NEXT_PUBLIC_APP_PATH_AUTH_CALLBACK=/auth/callback
NEXT_PUBLIC_APP_PATH_OAUTH_COMPLETE=/auth/oauth/complete
NEXT_PUBLIC_SUPABASE_ENV_MISSING=Supabase Auth is not configured.
# Optional: custom CDN/CNAME host for next/image (no scheme). Do not use upstream vendor hostnames in production.
# NEXT_PUBLIC_MEDIA_CDN_HOST=media.yourdomain.com
